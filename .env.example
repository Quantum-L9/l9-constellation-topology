# Foundational HMAC profile. Populate through the runner secret store, never Git.
L9_DISPATCH_HMAC_KEY=
L9_DISPATCH_HMAC_KEY_ID=foundational-hmac-v1
L9_RESULT_HMAC_KEY_ID=foundational-hmac-v1

# Authenticated control-plane callback.
L9_CALLBACK_TOKEN=
L9_CONTROL_API_URL=
L9_CONTROL_API_TOKEN=

# Local recovery cache only. Postgres remains production registry authority.
L9_PACKET_REGISTRY_FILE=.l9-worker/packet-registry.json
