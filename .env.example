# Foundational HMAC profile. Populate through the runner secret store, never Git.
L9_DISPATCH_HMAC_KEY=
L9_DISPATCH_HMAC_KEY_ID=foundational-hmac-v1
L9_RESULT_HMAC_KEY_ID=foundational-hmac-v1

# Worker-local callback registry values. Dispatch packets select only a callback ID.
# The production callback is deny-all until its approved host is committed in policy.
L9_CALLBACK_TOKEN=
L9_CONTROL_API_URL=
# Local integration tests only.
L9_TEST_CALLBACK_URL=
L9_CONTROL_API_TOKEN=

# Local recovery cache only. Postgres remains production registry authority.
L9_PACKET_REGISTRY_FILE=.l9-worker/packet-registry.sqlite3
