{
  "$defs": {
    "Authority": {
      "enum": [
        "source",
        "validated-machine",
        "derived",
        "candidate",
        "unknown"
      ],
      "title": "Authority",
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "partial",
        "sufficient",
        "complete"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "ConfidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "conflict_status": {
          "$ref": "#/$defs/ConflictStatus",
          "default": "none"
        },
        "derivation_method": {
          "$ref": "#/$defs/DerivationMethod"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        }
      },
      "required": [
        "level",
        "evidence_strength",
        "derivation_method",
        "authority",
        "completeness"
      ],
      "title": "ConfidenceAssessment",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "ConflictStatus": {
      "enum": [
        "none",
        "possible",
        "confirmed"
      ],
      "title": "ConflictStatus",
      "type": "string"
    },
    "CsvLocator": {
      "additionalProperties": false,
      "description": "A row of a delimited file.",
      "properties": {
        "kind": {
          "const": "csv",
          "default": "csv",
          "title": "Kind",
          "type": "string"
        },
        "row": {
          "minimum": 1,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "row"
      ],
      "title": "CsvLocator",
      "type": "object"
    },
    "DerivationMethod": {
      "enum": [
        "declared",
        "deterministic",
        "cross-record",
        "heuristic",
        "model-assisted",
        "unknown"
      ],
      "title": "DerivationMethod",
      "type": "string"
    },
    "DocxLocator": {
      "additionalProperties": false,
      "description": "A block within a Word document body, by ordinal and block kind.",
      "properties": {
        "block_index": {
          "minimum": 0,
          "title": "Block Index",
          "type": "integer"
        },
        "block_kind": {
          "title": "Block Kind",
          "type": "string"
        },
        "kind": {
          "const": "docx",
          "default": "docx",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "block_index",
        "block_kind"
      ],
      "title": "DocxLocator",
      "type": "object"
    },
    "EvidenceSourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "line_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Number"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "csv": "#/$defs/CsvLocator",
                  "docx": "#/$defs/DocxLocator",
                  "html": "#/$defs/HtmlLocator",
                  "line": "#/$defs/LineLocator",
                  "notebook": "#/$defs/NotebookLocator",
                  "pdf": "#/$defs/PdfLocator",
                  "pptx": "#/$defs/PptxLocator",
                  "spreadsheet": "#/$defs/SpreadsheetLocator"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LineLocator"
                },
                {
                  "$ref": "#/$defs/PdfLocator"
                },
                {
                  "$ref": "#/$defs/DocxLocator"
                },
                {
                  "$ref": "#/$defs/PptxLocator"
                },
                {
                  "$ref": "#/$defs/SpreadsheetLocator"
                },
                {
                  "$ref": "#/$defs/NotebookLocator"
                },
                {
                  "$ref": "#/$defs/CsvLocator"
                },
                {
                  "$ref": "#/$defs/HtmlLocator"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "packet_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "title": "EvidenceSourceRef",
      "type": "object"
    },
    "EvidenceStrength": {
      "enum": [
        "none",
        "weak",
        "corroborated",
        "direct"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "HtmlLocator": {
      "additionalProperties": false,
      "description": "A node, by an index stable under the producer's own traversal order.",
      "properties": {
        "kind": {
          "const": "html",
          "default": "html",
          "title": "Kind",
          "type": "string"
        },
        "stable_node_index": {
          "minimum": 0,
          "title": "Stable Node Index",
          "type": "integer"
        }
      },
      "required": [
        "stable_node_index"
      ],
      "title": "HtmlLocator",
      "type": "object"
    },
    "LineLocator": {
      "additionalProperties": false,
      "description": "A 1-based inclusive line span, for a format that has lines.",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "kind": {
          "const": "line",
          "default": "line",
          "title": "Kind",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "LineLocator",
      "type": "object"
    },
    "NotebookLocator": {
      "additionalProperties": false,
      "description": "A notebook cell by ordinal and declared cell type.",
      "properties": {
        "cell_index": {
          "minimum": 0,
          "title": "Cell Index",
          "type": "integer"
        },
        "cell_type": {
          "title": "Cell Type",
          "type": "string"
        },
        "kind": {
          "const": "notebook",
          "default": "notebook",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "cell_index",
        "cell_type"
      ],
      "title": "NotebookLocator",
      "type": "object"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "description": "A block on a page. A PDF page is not a line and has no line numbers.",
      "properties": {
        "block_index": {
          "minimum": 0,
          "title": "Block Index",
          "type": "integer"
        },
        "kind": {
          "const": "pdf",
          "default": "pdf",
          "title": "Kind",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "block_index"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "PptxLocator": {
      "additionalProperties": false,
      "description": "A shape on a slide.",
      "properties": {
        "kind": {
          "const": "pptx",
          "default": "pptx",
          "title": "Kind",
          "type": "string"
        },
        "shape_index": {
          "minimum": 0,
          "title": "Shape Index",
          "type": "integer"
        },
        "slide_number": {
          "minimum": 1,
          "title": "Slide Number",
          "type": "integer"
        }
      },
      "required": [
        "slide_number",
        "shape_index"
      ],
      "title": "PptxLocator",
      "type": "object"
    },
    "SpreadsheetLocator": {
      "additionalProperties": false,
      "description": "A cell or range on a named sheet, in the workbook's own A1 vocabulary.",
      "properties": {
        "cell_or_range": {
          "title": "Cell Or Range",
          "type": "string"
        },
        "kind": {
          "const": "spreadsheet",
          "default": "spreadsheet",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "title": "Sheet",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "cell_or_range"
      ],
      "title": "SpreadsheetLocator",
      "type": "object"
    }
  },
  "$id": "https://quantum-l9.dev/schemas/evidence-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "$ref": "#/$defs/ConfidenceAssessment"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_class": {
      "enum": [
        "observed",
        "declared",
        "derived",
        "assisted",
        "projected",
        "validated",
        "committed"
      ],
      "title": "Evidence Class",
      "type": "string"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "title": "Producer Version",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/EvidenceSourceRef"
    },
    "source_type": {
      "enum": [
        "file",
        "packet",
        "inference",
        "validation",
        "unknown"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "value": {
      "title": "Value"
    }
  },
  "required": [
    "evidence_id",
    "subject_id",
    "stage",
    "evidence_class",
    "source_type",
    "source_ref",
    "value",
    "confidence",
    "producer",
    "producer_version"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
