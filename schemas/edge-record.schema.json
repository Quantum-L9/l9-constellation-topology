{
  "$defs": {
    "Authority": {
      "enum": [
        "source",
        "validated-machine",
        "derived",
        "candidate",
        "unknown"
      ],
      "title": "Authority",
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "partial",
        "sufficient",
        "complete"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "ConfidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "conflict_status": {
          "$ref": "#/$defs/ConflictStatus",
          "default": "none"
        },
        "derivation_method": {
          "$ref": "#/$defs/DerivationMethod"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        }
      },
      "required": [
        "level",
        "evidence_strength",
        "derivation_method",
        "authority",
        "completeness"
      ],
      "title": "ConfidenceAssessment",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "ConflictStatus": {
      "enum": [
        "none",
        "possible",
        "confirmed"
      ],
      "title": "ConflictStatus",
      "type": "string"
    },
    "DerivationMethod": {
      "enum": [
        "declared",
        "deterministic",
        "cross-record",
        "heuristic",
        "model-assisted",
        "unknown"
      ],
      "title": "DerivationMethod",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "outbound",
        "inbound",
        "bidirectional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EdgeType": {
      "enum": [
        "CONTAINS",
        "DEPENDS_ON",
        "IMPLEMENTS",
        "EXPOSES",
        "VALIDATED_BY",
        "GOVERNED_BY",
        "OWNED_BY",
        "DOCUMENTED_BY",
        "PRODUCES",
        "CONSUMES",
        "DERIVED_FROM",
        "SUPERSEDES",
        "ROUTES_TO",
        "PUBLISHES_TO",
        "MEMBER_OF",
        "DUPLICATE_OF",
        "BLOCKED_BY",
        "REFERENCES"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "EvidenceStrength": {
      "enum": [
        "none",
        "weak",
        "corroborated",
        "direct"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    }
  },
  "$id": "https://quantum-l9.dev/schemas/edge-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "$ref": "#/$defs/ConfidenceAssessment"
    },
    "direction": {
      "$ref": "#/$defs/Direction",
      "default": "outbound"
    },
    "edge_id": {
      "title": "Edge Id",
      "type": "string"
    },
    "edge_type": {
      "$ref": "#/$defs/EdgeType"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "properties": {
      "additionalProperties": true,
      "title": "Properties",
      "type": "object"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "edge_id",
    "source_id",
    "target_id",
    "edge_type"
  ],
  "title": "EdgeRecord",
  "type": "object"
}
