{
  "$defs": {
    "Authority": {
      "enum": [
        "source",
        "validated-machine",
        "derived",
        "candidate",
        "unknown"
      ],
      "title": "Authority",
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "partial",
        "sufficient",
        "complete"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "ConfidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "conflict_status": {
          "$ref": "#/$defs/ConflictStatus",
          "default": "none"
        },
        "derivation_method": {
          "$ref": "#/$defs/DerivationMethod"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        }
      },
      "required": [
        "level",
        "evidence_strength",
        "derivation_method",
        "authority",
        "completeness"
      ],
      "title": "ConfidenceAssessment",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "ConflictStatus": {
      "enum": [
        "none",
        "possible",
        "confirmed"
      ],
      "title": "ConflictStatus",
      "type": "string"
    },
    "DerivationMethod": {
      "enum": [
        "declared",
        "deterministic",
        "cross-record",
        "heuristic",
        "model-assisted",
        "unknown"
      ],
      "title": "DerivationMethod",
      "type": "string"
    },
    "EvidenceStrength": {
      "enum": [
        "none",
        "weak",
        "corroborated",
        "direct"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    }
  },
  "$id": "https://quantum-l9.dev/schemas/repository-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adr_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Adr Refs",
      "type": "array"
    },
    "artifact_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "capability_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Capability Ids",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceAssessment"
    },
    "downstream_repository_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Downstream Repository Ids",
      "type": "array"
    },
    "entrypoints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Entrypoints",
      "type": "array"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "governance_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Governance Refs",
      "type": "array"
    },
    "languages": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Owner Ids",
      "type": "array"
    },
    "package_managers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Package Managers",
      "type": "array"
    },
    "packet_ref": {
      "title": "Packet Ref",
      "type": "string"
    },
    "primary_role": {
      "default": "unknown",
      "title": "Primary Role",
      "type": "string"
    },
    "repository_id": {
      "title": "Repository Id",
      "type": "string"
    },
    "secondary_roles": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Secondary Roles",
      "type": "array"
    },
    "source_revision": {
      "title": "Source Revision",
      "type": "string"
    },
    "unresolved_dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unresolved Dependencies",
      "type": "array"
    },
    "upstream_repository_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Upstream Repository Ids",
      "type": "array"
    },
    "workflows": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Workflows",
      "type": "array"
    }
  },
  "required": [
    "repository_id",
    "name",
    "source_revision",
    "packet_ref"
  ],
  "title": "RepositoryRecord",
  "type": "object"
}
