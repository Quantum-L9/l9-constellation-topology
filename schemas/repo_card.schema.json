{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo_card.schema.json",
  "title": "RepoCard",
  "type": "object",
  "required": ["repo_id", "name", "path", "primary_role", "confidence"],
  "properties": {
    "repo_id": {"type": "string"},
    "name": {"type": "string"},
    "path": {"type": "string"},
    "primary_role": {"type": "string"},
    "secondary_roles": {"type": "array", "items": {"type": "string"}},
    "languages": {"type": "array", "items": {"type": "string"}},
    "package_managers": {"type": "array", "items": {"type": "string"}},
    "entrypoints": {"type": "array", "items": {"type": "string"}},
    "ci_workflows": {"type": "array", "items": {"type": "string"}},
    "adr_files": {"type": "array", "items": {"type": "string"}},
    "governance_files": {"type": "array", "items": {"type": "string"}},
    "upstream_dependencies": {"type": "array", "items": {"type": "string"}},
    "downstream_dependents": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"},
    "evidence": {"type": "array"},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
  }
}
